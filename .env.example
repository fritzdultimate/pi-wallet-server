# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Local MongoDB for development. No credentials baked into source anywhere.
MONGODB_URI=mongodb://127.0.0.1:27017/pi_wallet_local

# --- Auth (single owner) ---
# Generate a bcrypt hash for your chosen password, e.g.:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password-here'
OWNER_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Encryption at rest for wallet mnemonics ---
# 32-byte key, hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this OUTSIDE the database backup. Losing it means losing access to stored mnemonics.
MASTER_KEY=

# --- Stellar / Pi Network horizon ---
# Direct Horizon endpoint only. No proxy rotation - this is a personal tool, not something
# that needs to disguise its traffic as many different users.
HORIZON_URL=https://api.mainnet.minepi.com
NETWORK_PASSPHRASE=Pi Network

# --- Your own destination address(es) ---
# Claims and sweeps only ever go to an address YOU set here or in Settings via the
# authenticated dashboard - never to a value supplied in an incoming request.
DEFAULT_DESTINATION_ADDRESS=

# --- Optional: Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
